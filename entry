#!/bin/sh
set -ex

trap exit TERM INT

BIN_DIR="/usr/sbin"

info() {
    { set +x; } 2> /dev/null
    echo '[INFO] ' "$@"
    set -x
}

check_iptables_mode() {
    set +e
    # In kubernetes 1.17 and later, kubelet will have created at least
	# one chain in the "mangle" table (either "KUBE-IPTABLES-HINT" or
	# "KUBE-KUBELET-CANARY"), so check that first, against
	# iptables-nft, because we can check that more efficiently and
	# it's more common these days.
    kubelet_chain='^:(KUBE-IPTABLES-HINT|KUBE-KUBELET-CANARY)'

    # nft is cheap to probe with `-t mangle`; legacy is saved without `-t` since
    # `iptables-legacy-save -t mangle` would create that table if it were missing.
    if { xtables-nft-multi iptables-save -t mangle; xtables-nft-multi ip6tables-save -t mangle; } 2> /dev/null | grep -Eq "${kubelet_chain}"; then
        mode=nft
    elif { xtables-legacy-multi iptables-save; xtables-legacy-multi ip6tables-save; } 2> /dev/null | grep -Eq "${kubelet_chain}"; then
        mode=legacy
    else
        mode=nft
    fi
    set -e

    if [ "$mode" = legacy ]; then
        info "legacy mode detected"
        set_legacy
    else
        info "nft mode detected"
        set_nft
    fi
}

set_nft() {
    for i in iptables iptables-save iptables-restore ip6tables; do 
        ln -sf xtables-nft-multi "$BIN_DIR/$i";
    done
}

set_legacy() {
    for i in iptables iptables-save iptables-restore ip6tables; do 
        ln -sf xtables-legacy-multi "$BIN_DIR/$i";
    done
}

start_proxy() {
    for src_range in ${SRC_RANGES//,/ }; do
        if echo ${src_range} | grep -Eq ":"; then
            ip6tables -t filter -I FORWARD -s ${src_range} -p ${DEST_PROTO} --dport ${DEST_PORT} -j ACCEPT
        else
            iptables -t filter -I FORWARD -s ${src_range} -p ${DEST_PROTO} --dport ${DEST_PORT} -j ACCEPT
        fi
    done

    for dest_ip in ${DEST_IPS//,/ }; do
        if echo ${dest_ip} | grep -Eq ":"; then
            if [ $(cat /proc/sys/net/ipv6/conf/all/forwarding) == 1 ]; then
                ip6tables -t filter -A FORWARD -d ${dest_ip}/128 -p ${DEST_PROTO} --dport ${DEST_PORT} -j DROP
                ip6tables -t nat -I PREROUTING -p ${DEST_PROTO} --dport ${SRC_PORT} -j DNAT --to [${dest_ip}]:${DEST_PORT}
                ip6tables -t nat -I POSTROUTING -d ${dest_ip}/128 -p ${DEST_PROTO} -j MASQUERADE
            fi
        else
            if [ $(cat /proc/sys/net/ipv4/ip_forward) == 1 ]; then
                iptables -t filter -A FORWARD -d ${dest_ip}/32 -p ${DEST_PROTO} --dport ${DEST_PORT} -j DROP
                iptables -t nat -I PREROUTING -p ${DEST_PROTO} --dport ${SRC_PORT} -j DNAT --to ${dest_ip}:${DEST_PORT}
                iptables -t nat -I POSTROUTING -d ${dest_ip}/32 -p ${DEST_PROTO} -j MASQUERADE
            fi
        fi
    done
}

check_iptables_mode
start_proxy

if [ ! -e /pause ]; then
    mkfifo /pause
fi
</pause
